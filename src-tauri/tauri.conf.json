{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orpheon",
  "version": "0.1.1",
  "identifier": "com.orpheon.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orpheon",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost http: https: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; media-src 'self' asset: http://asset.localhost https://asset.localhost; worker-src 'self'; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/com.orpheon.app/artwork/**",
            "$APPLOCALDATA/com.orpheon.app/artwork/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../vendor/vlc/libvlc.dll": "libvlc.dll",
      "../vendor/vlc/libvlccore.dll": "libvlccore.dll",
      "../vendor/vlc/plugins/": "plugins/",
      "../vendor/vlc/COPYING.txt": "COPYING.VideoLAN.txt",
      "../vendor/vlc/COPYING.LGPLv2.1": "COPYING.LGPLv2.1.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
